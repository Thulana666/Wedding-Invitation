# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Public URL of the site (used for WhatsApp / Open Graph previews and links).
# Optional on Vercel — the Vercel production address is used automatically.
# Set it when you add a custom domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL connection string. Leave empty in local development to use the
# embedded database stored in ./.data (no installation needed).
# Required in production, e.g. a Neon / Supabase / Railway Postgres URL.
DATABASE_URL=

# Optional: folder for the embedded development database (default ./.data/pglite).
# If this project lives inside OneDrive / Dropbox / iCloud, point this OUTSIDE the
# synced folder — file sync breaks the embedded database while it is open.
# PGLITE_DIR=C:\Users\<you>\AppData\Local\dilki-supun-wedding\pglite

# Admin dashboard login (/admin/login).
ADMIN_USERNAME=admin
# Either a plain password (min. 12 characters) ...
ADMIN_PASSWORD=
# ... or a scrypt hash created with: node scripts/hash-password.mjs "your password"
# (when set, ADMIN_PASSWORD is ignored)
ADMIN_PASSWORD_HASH=

# Secret used to sign admin sessions. At least 32 random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
